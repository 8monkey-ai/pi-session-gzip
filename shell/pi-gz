#!/bin/sh
# pi shim: restore a compressed session before pi reads it at startup, then
# exec the real pi. Point PI_ACP_PI_COMMAND (or PATH) at this script.
prev=""
for a in "$@"; do
	if [ "$prev" = "--session" ] && [ -e "$a.gz" ]; then
		gzip -dc "$a.gz" >"$a.tmp-$$" && mv "$a.tmp-$$" "$a"
	fi
	prev="$a"
done
exec pi "$@"
